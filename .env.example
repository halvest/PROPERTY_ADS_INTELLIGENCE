# HD Creative (Haspro Digital Creative) — Environment Variables Template
# Copy this file to .env.local for local development.
# DO NOT commit real secrets, service-role keys, or access tokens to version control.

# Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Production Meta policy URLs use https://hdcreative.cloud.
APP_ENV=development

# Supabase (Browser & Server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase (Server-only — NEVER expose to browser)
SUPABASE_SERVICE_ROLE_KEY=

# Security & Credential Encryption (Server-only — NEVER expose to browser)
# 32-byte secret used for AES-256-GCM encryption of Meta Ads access tokens at rest
# REQUIRED in production; must be a dedicated key, not reused from other secrets.
TOKEN_ENCRYPTION_KEY=
# 64-character hex key (32 bytes) for AES-256-GCM encryption of WhatsApp tokens (server-only)
WHATSAPP_TOKEN_ENCRYPTION_KEY=
# Secret for HMAC phone-number hashing. Set before first production data;
# changing it later breaks matching against previously stored phone hashes.
PHONE_HASH_SECRET=

# Meta Marketing API, WhatsApp Embedded Signup & Graph API
# Obtain from Meta for Developers (https://developers.facebook.com)
# IMPORTANT: META_APP_ID and NEXT_PUBLIC_META_APP_ID MUST use the exact same Meta App ID.
META_APP_ID=
NEXT_PUBLIC_META_APP_ID=
META_APP_SECRET=
META_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/meta/callback
# Keep server and browser Graph API versions aligned to prevent Meta JS SDK mismatches.
META_GRAPH_API_VERSION=v27.0
NEXT_PUBLIC_META_GRAPH_API_VERSION=v27.0
META_GRAPH_BASE_URL=https://graph.facebook.com

# Meta Embedded Signup (WhatsApp Business App Coexistence) & Webhook
NEXT_PUBLIC_META_EMBEDDED_SIGNUP_CONFIG_ID=
# Meta Webhook Verification Token (configured in Meta App Dashboard -> WhatsApp -> Configuration)
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Optional System-level Meta Marketing API & Business Messaging CAPI (Server-only)
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_CAPI_DATASET_ID=
META_CAPI_ACCESS_TOKEN=

# AI Model Inference (Server-only — also used as default by CTWA Lead Intelligence Engine)
MODEL_API_KEY=
META_MODEL_BASE_URL=https://api.meta.ai/v1
META_MUSE_SPARK_MODEL=muse-spark-1.3

# CTWA Lead Intelligence Worker Auth & Optional LLM Overrides (Server-only)
CRON_SECRET=
# Optional overrides (defaults to META_MODEL_BASE_URL, MODEL_API_KEY, META_MUSE_SPARK_MODEL)
# LEAD_AI_API_BASE_URL=
# LEAD_AI_API_KEY=
# LEAD_AI_MODEL=

# AI analysis quota: disabled during testing; set to true when production quota enforcement is ready.
AI_ANALYSIS_QUOTA_ENABLED=false
