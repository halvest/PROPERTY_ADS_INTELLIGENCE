# HD Creative (Haspro Digital Creative) — Environment Variables Template
# Copy this file to .env.local for local development.
# DO NOT commit real secrets, service-role keys, or access tokens to version control.

# Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Production Meta policy URLs use https://hdcreative.cloud.
APP_ENV=development

# Supabase (Browser & Server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase (Server-only — NEVER expose to browser)
SUPABASE_SERVICE_ROLE_KEY=

# Security & Credential Encryption (Server-only — NEVER expose to browser)
# 32-byte secret used for AES-256-GCM encryption of Meta access tokens at rest
# REQUIRED in production; must be a dedicated key, not reused from other secrets.
TOKEN_ENCRYPTION_KEY=
# Secret for HMAC phone-number hashing. Set before first production data;
# changing it later breaks matching against previously stored phone hashes.
PHONE_HASH_SECRET=

# Meta Marketing API & OAuth Connector (Server-only — NEVER expose to browser)
# Obtain from Meta for Developers (https://developers.facebook.com)
META_APP_ID=
META_APP_SECRET=
META_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/meta/callback
META_GRAPH_API_VERSION=v26.0
META_GRAPH_BASE_URL=https://graph.facebook.com

# Public Meta App ID used to start read-only Marketing API authorization
NEXT_PUBLIC_META_APP_ID=

# Optional System-level Meta Marketing API credentials (for automated background workers)
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=

# AI Model Inference (Server-only)
MODEL_API_KEY=
META_MODEL_BASE_URL=https://api.meta.ai/v1
META_MUSE_SPARK_MODEL=muse-spark-1.3
