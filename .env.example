# HD Creative (Haspro Digital Creative) — Environment Variables Template
# Copy this file to .env.local for local development.
# DO NOT commit real secrets, service-role keys, or access tokens to version control.

# Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_ENV=development
DATA_MODE=development # Server-only demo switch: use 'demo' only for an isolated demo deployment; client cookies/params cannot enable demo mode

# Supabase (Browser & Server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase (Server-only — NEVER expose to browser)
SUPABASE_SERVICE_ROLE_KEY=

# Security & Credential Encryption (Server-only — NEVER expose to browser)
# 32-byte secret used for AES-256-GCM encryption of Meta & WhatsApp access tokens at rest
# REQUIRED in production; must be a dedicated key, not reused from other secrets.
TOKEN_ENCRYPTION_KEY=
# Secret for HMAC phone-number hashing. Set before first production data;
# changing it later breaks matching against previously stored phone hashes.
PHONE_HASH_SECRET=

# Meta Marketing API & OAuth Connector (Server-only — NEVER expose to browser)
# Obtain from Meta for Developers (https://developers.facebook.com)
META_APP_ID=
META_APP_SECRET=
META_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/meta/callback
META_GRAPH_API_VERSION=v21.0
META_GRAPH_BASE_URL=https://graph.facebook.com

# Optional System-level Meta Marketing API credentials (for automated background workers)
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=

# WhatsApp Business Platform Webhook & App Security (Server-only — NEVER expose to browser)
# Webhook URL to register in Meta App Dashboard: https://yourdomain.com/api/webhook/whatsapp
# Note: HD Creative is multi-tenant SaaS. Customer access tokens, phone number IDs,
# and WABA IDs are connected per-tenant via Meta Embedded Signup and stored encrypted
# in the database (whatsapp_connection_secrets). Do NOT enter customer credentials in this file.
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# Meta Embedded Signup Coexistence (Browser & Server)
# Configuration ID from Meta App Dashboard > Facebook Login for Business > Configurations
NEXT_PUBLIC_META_APP_ID=
NEXT_PUBLIC_WHATSAPP_CONFIG_ID=
WHATSAPP_CONFIG_ID=

# AI Model Inference (Server-only)
MODEL_API_KEY=
META_MODEL_BASE_URL=https://api.meta.ai/v1
META_MUSE_SPARK_MODEL=muse-spark-1.3
